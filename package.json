{
  "name": "f1-career-bumps",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Cameron Griffin",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "homepage": "https://f1datadesktop.com",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "dev:local": "node server/devLocal.js",
    "db:seed": "node server/seedDatabase.js",
    "db:seed:ddb": "node server/seedDynamoDb.js",
    "db:update:f1": "node server/updateDynamoFromFormula1.js",
    "db:update:formula1": "node server/updateDynamoFromFormula1.js",
    "pipeline:update": "node server/updateRacePipeline.js",
    "pipeline:refresh": "node server/refreshRacePublications.js",
    "pipeline:update:official": "node server/updateRacePipeline.js --official-only",
    "pipeline:backfill": "node server/backfillRaceAnalytics.js",
    "pipeline:sync": "node server/syncLocalRaceAnalyticsToDynamo.js",
    "pipeline:fixture": "node server/replayTimingFixture.js",
    "timing:prepare:fixture": "node server/runTimingRecorderFixture.js --prepare",
    "timing:record:fixture": "node server/runTimingRecorderFixture.js",
    "timing:check:fixture": "node server/runTimingCheckFixture.js",
    "timing:check:request": "node server/createIngestionCheckRequest.js",
    "timing:check:schedules": "node server/createTimingCheckSchedules.js",
    "db:check:ddb": "node server/checkDynamoDbAccess.js",
    "env:check": "node server/checkEnvFiles.js",
    "test": "node --test server/*.test.js",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "postbuild": "node scripts/generateSeoArtifacts.js && node scripts/verifySeoArtifacts.js",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1088.0",
    "@aws-sdk/client-ecs": "^3.1096.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/client-sqs": "^3.1096.0",
    "@aws-sdk/lib-dynamodb": "^3.1088.0",
    "axios": "^1.9.0",
    "chart.js": "^4.4.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@netlify/vite-plugin": "^2.12.9",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
