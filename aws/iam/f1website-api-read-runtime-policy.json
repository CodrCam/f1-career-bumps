{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSeasonData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-west-2:326204891372:table/f1-website-data"
    },
    {
      "Sid": "WriteFunctionLogs",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-west-2:326204891372:*"
    },
    {
      "Sid": "WriteFunctionLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-west-2:326204891372:log-group:/aws/lambda/f1-website-seasons-api:*"
    }
  ]
}
