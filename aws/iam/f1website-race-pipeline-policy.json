{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteValidatedRaceData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchWriteItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable",
        "dynamodb:PutItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-west-2:*:table/f1-website-data"
    },
    {
      "Sid": "WriteRawRaceSnapshots",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_RAW_BUCKET_NAME/raw/*"
    }
  ]
}
