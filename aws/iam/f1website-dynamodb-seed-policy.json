{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeedF1WebsiteDynamoDb",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchWriteItem",
        "dynamodb:CreateTable",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:TagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-2:*:table/f1-website-data"
      ]
    }
  ]
}
