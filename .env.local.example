AWS_ACCESS_KEY_ID=your_local_iam_access_key
AWS_SECRET_ACCESS_KEY=your_local_iam_secret
# AWS_SESSION_TOKEN=only_needed_for_temporary_credentials
AWS_REGION=us-west-2
DYNAMODB_TABLE=f1-website-data
F1_RAW_DATA_BUCKET=your-private-raw-data-bucket

# Optional ingestion overrides.
# FASTF1_PYTHON=.venv/bin/python
# F1_RAW_DATA_DIR=.data

# Optional local frontend override. Leave blank to use the Vite proxy in local dev.
VITE_API_BASE_URL=

# Optional. Keep false/blank when validating the real API/database path.
# VITE_ALLOW_JSON_FALLBACK=false
